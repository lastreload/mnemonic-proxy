# Example systemd *user* unit. Copy to ~/.config/systemd/user/ctx-proxy.service, replace the /path/to/... placeholders,
# then: systemctl --user daemon-reload && systemctl --user enable --now ctx-proxy
[Unit]
Description=virtual-context-proxy in front of Strata (127.0.0.1:8096 -> 127.0.0.1:8095)
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/virtual-context-proxy
Environment=CTXPROXY_CONFIG=/path/to/config.json
ExecStart=/path/to/venv/bin/python -m ctxproxy.server --host 127.0.0.1 --port 8096 \
  --upstream http://127.0.0.1:8095 --data /path/to/ctxproxy-data --config ${CTXPROXY_CONFIG} \
  --tokenizer /path/to/strata/packs/<pack>/tokenizer
Restart=on-failure
RestartSec=3
MemoryMax=8G

[Install]
WantedBy=default.target
